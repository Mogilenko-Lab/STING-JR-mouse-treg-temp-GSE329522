# Data files (track structure via .gitkeep, not contents)
00_data/raw/*
!00_data/raw/.gitkeep
00_data/processed/*
!00_data/processed/.gitkeep
!00_data/processed/PROVENANCE.md
00_data/references/*
!00_data/references/.gitkeep

# Results — track the directory skeleton (.gitkeep) and caption READMEs, never artifacts.
# Hard-ignore checkpoint state objects at any depth (large + recomputable).
03_results/objects/*.h5ad
03_results/objects/*.rds
03_results/objects/*.rdata
03_results/objects/*.parquet

# Pathway-explorer render outputs + heavy consolidated bundle tables — all
# regenerable from 02_analysis/scripts/pathway_explorer_adapter/run_pathway_explorer.sh
# (18 MB/contrast HTML x7, plus 23 MB master_unified / 13 MB master_de_table).
# Track the reproducer + tiny explorer_manifest.json provenance + README captions instead.
03_results/interactive/index.html
03_results/interactive/pathway_explorer_*.html
03_results/interactive/reference_embedding.parquet
03_results/interactive/leiden_identity_badges.json
03_results/master/master_unified.csv
03_results/master/master_de_table.csv
03_results/master/explorer_universe.csv
03_results/master/atlas_gene_universe.txt

# Ignore data artifacts within phase dirs at any depth, keep the skeleton.
# Decided to leave for now
#03_results/**/figures/**/*.pdf
#03_results/**/figures/**/*.png
#03_results/**/figures/**/*.svg
#03_results/**/tables/**/*.csv
#03_results/**/tables/**/*.tsv

# Scratch: throwaway artifacts, never committed
scratch/
03_results/_scratch/*
!03_results/_scratch/.gitkeep

# Rendered notebook HTML — regenerable via 02_analysis/notebooks/render.R.
# Commit the gfm .md + its *_files/ figure dir instead (GitHub renders those inline).
# Each notebook lives in its own folder, so match nested .html too.
02_analysis/notebooks/**/*.html

# marimo editor session cache written next to the app source (cell outputs/state).
# Machine-generated and rewritten on every edit; the .py app IS the notebook.
__marimo__/

# Keep .gitkeep placeholders everywhere under 03_results/.
!03_results/**/.gitkeep

# Reference codebases (gitignored by default — add explicitly if needed)
01_modules/.ref/

# Project-local R library (paths.r_library). Compiled package binaries, rebuilt by
# 02_analysis/config/env/r_library.md; the recipe is tracked, the bytes are not.
01_modules/Rlib/

# Logs
logs/
*.log

# Secrets and env
.env
.env.local
.env.*
!.env.example
*.pem
*.key
credentials.json
.mcp.json

# CLI auth configs
.gemini/
.codex/

# R artifacts
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Python artifacts
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*.log

# Timestamped backup copies the provisioner drops beside a file it rewrites
# (e.g. .devcontainer/docker-compose.yml.provc.1784934767) — never project state.
*.provc.*

.venv_pkgs/
# BEGIN SCIAGENT:GITIGNORE
docs/_internal/
.claude/
.agents/
.gemini/
.sciagent/
02_analysis/helpers/figure-style
.mcp.json
.env
.env.*
# END SCIAGENT:GITIGNORE
